{
  "name": "nexwire-express",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "bin": {
    "maker": "./src/framework/maker-cli/index.mjs"
  },
  "scripts": {
    "build": "npm run build:all",
    "build:all": "npm run build:backend && npm run build:ui",
    "build:backend": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:ui": "node src/framework/maker-cli/runtime/build-ui.mjs",
    "dev": "node src/framework/maker-cli/index.mjs dev",
    "backend": "node src/framework/maker-cli/index.mjs serve --src",
    "ui": "node src/framework/maker-cli/index.mjs ui:dev",
    "maildev:view": "node src/framework/maker-cli/index.mjs maildev:view",
    "redis:view": "node src/framework/maker-cli/index.mjs redis:view",
    "db:studio": "node src/framework/maker-cli/index.mjs db:studio",
    "maker": "node src/framework/maker-cli/index.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@bull-board/api": "^9.10.5",
    "@bull-board/express": "^9.10.5",
    "@libsql/client": "^0.17.4",
    "@scalar/express-api-reference": "^0.10.19",
    "@socket.io/admin-ui": "^0.5.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@unhead/vue": "^3.4.3",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vuepic/vue-datepicker": "^14.0.0",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bullmq": "^5.81.3",
    "bullmq-durable": "^0.2.0",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "glob": "^13.0.6",
    "http-errors": "^2.0.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "lodash-es": "^4.18.1",
    "luxon": "^3.7.2",
    "maildev": "^3.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "mysql2": "^3.23.3",
    "nodemailer": "^10.2.1",
    "pinia": "^3.0.4",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "redis-commander": "^0.9.0",
    "sass": "^1.100.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.5",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-select": "^4.0.0-beta.6",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "@maildev/mcp": {
      "zod": "^4.6.7"
    },
    "@maildev/smtp": {
      "jsdom": "^27.4.0",
      "nodemailer": "^10.2.1"
    },
    "redis-commander": {
      "express": "^4.22.3",
      "body-parser": "^1.20.9",
      "bcrypt": "npm:bcryptjs@^3.0.3",
      "bcryptjs": "^3.0.3"
    }
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "msgpackr-extract": true,
    "redis-commander": true,
    "vue-demi": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bootstrap": "^5.2.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3",
    "pnpm": ">=11",
    "yarn": ">=4"
  }
}
