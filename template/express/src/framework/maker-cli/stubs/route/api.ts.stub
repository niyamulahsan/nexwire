import { createRoute, group, HttpStatusCodes, jsonContent } from "@/framework/facade.js";
import { authMiddleware } from "@/middlewares/auth-middleware.js";
import { requireRole } from "@/middlewares/role-middleware.js";
import { destroy, index, show, store, update } from "@/modules/{{module}}/controllers/{{controller}}.js";
import {
  Create{{ClassName}}Schema,
  {{ClassName}}IdParamsSchema,
  {{ClassName}}ListResponseSchema,
  {{ClassName}}MessageSchema,
  {{ClassName}}ResponseSchema,
  Update{{ClassName}}Schema
} from "@/modules/{{module}}/schemas/{{controller}}.js";

const indexRoute = createRoute({
  path: "/",
  method: "get",
  tags: ["{{ModuleClass}}"],
  responses: {
    [HttpStatusCodes.OK]: jsonContent({{ClassName}}ListResponseSchema, "{{module}} list")
  }
});

const showRoute = createRoute({
  path: "/{id}",
  method: "get",
  tags: ["{{ModuleClass}}"],
  request: {
    params: {{ClassName}}IdParamsSchema
  },
  responses: {
    [HttpStatusCodes.OK]: jsonContent({{ClassName}}ResponseSchema, "{{module}} item"),
    [HttpStatusCodes.NOT_FOUND]: jsonContent({{ClassName}}MessageSchema, "Not found")
  }
});

const storeRoute = createRoute({
  path: "/",
  method: "post",
  tags: ["{{ModuleClass}}"],
  request: {
    body: jsonContent(Create{{ClassName}}Schema, "Create {{module}} payload")
  },
  responses: {
    [HttpStatusCodes.CREATED]: jsonContent({{ClassName}}MessageSchema, "Created")
  }
});

const updateRoute = createRoute({
  path: "/{id}",
  method: "put",
  tags: ["{{ModuleClass}}"],
  request: {
    params: {{ClassName}}IdParamsSchema,
    body: jsonContent(Update{{ClassName}}Schema, "Update {{module}} payload")
  },
  responses: {
    [HttpStatusCodes.OK]: jsonContent({{ClassName}}MessageSchema, "Updated"),
    [HttpStatusCodes.NOT_FOUND]: jsonContent({{ClassName}}MessageSchema, "Not found")
  }
});

const destroyRoute = createRoute({
  path: "/{id}",
  method: "delete",
  tags: ["{{ModuleClass}}"],
  request: {
    params: {{ClassName}}IdParamsSchema
  },
  responses: {
    [HttpStatusCodes.OK]: jsonContent({{ClassName}}MessageSchema, "Deleted"),
    [HttpStatusCodes.NOT_FOUND]: jsonContent({{ClassName}}MessageSchema, "Not found")
  }
});

export default group()
  .api(indexRoute, index)
  .api(showRoute, show)
  .api(storeRoute, store)
  .api(updateRoute, update)
  .api(destroyRoute, destroy);

// Gate the whole group (authMiddleware resolves the session once for every route):
//   export default group(authMiddleware).api(indexRoute, index) ...
//
// Or gate a single route by role. requireRole reads the role authMiddleware set,
// so authMiddleware must run first:
//   group().api(destroyRoute, [authMiddleware, requireRole("admin")], destroy)
//
// Or group all authMiddleware and set single requireRole middleware
// so authMiddleware must run on all chain and requireRole single on per route:
//   group(authMiddleware).api(destroyRoute, [requireRole("admin")], destroy)
//
// Delete the imports above when you do not need them.

