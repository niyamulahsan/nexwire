import type { Request, Response } from "express";
import { HttpStatusCodes, resolveNotificationProvider } from "@/framework/facade.js";
import type { NotifiableTarget } from "@/framework/providers/contracts.js";

/** Read the authenticated owner. A missing auth context means the request is anonymous. */
function targetFrom(res: Response): NotifiableTarget | null {
  const auth = (res.locals as any)?.auth;
  if (!auth || auth.id === undefined || auth.id === null) return null;
  return { type: "{{notifiable}}", id: auth.id };
}

function unavailable(res: Response) {
  return res.status(HttpStatusCodes.SERVICE_UNAVAILABLE).json({
    message: "Notification provider not available. Restore src/modules/notification or register one in src/providers/."
  });
}

function unauthorized(res: Response) {
  return res.status(HttpStatusCodes.UNAUTHORIZED).json({ message: "Unauthorized" });
}

export const list = async (req: Request, res: Response) => {
  const provider = await resolveNotificationProvider();
  if (!provider) return unavailable(res);

  const target = targetFrom(res);
  if (!target) return unauthorized(res);

  const page = Math.max(1, Number(req.query.page) || 1);
  const perPage = Math.min(50, Math.max(1, Number(req.query.perPage) || 20));

  return res.json(await provider.list(target, { page, perPage }));
};

export const unreadCount = async (_req: Request, res: Response) => {
  const provider = await resolveNotificationProvider();
  if (!provider) return unavailable(res);

  const target = targetFrom(res);
  if (!target) return unauthorized(res);

  return res.json({ count: await provider.unreadCount(target) });
};

export const markRead = async (req: Request, res: Response) => {
  const provider = await resolveNotificationProvider();
  if (!provider) return unavailable(res);

  const target = targetFrom(res);
  if (!target) return unauthorized(res);

  await provider.markRead(target, String(req.params.id));
  return res.json({ ok: true });
};

export const markAllRead = async (_req: Request, res: Response) => {
  const provider = await resolveNotificationProvider();
  if (!provider) return unavailable(res);

  const target = targetFrom(res);
  if (!target) return unauthorized(res);

  await provider.markAllRead(target);
  return res.json({ ok: true });
};

export const remove = async (req: Request, res: Response) => {
  const provider = await resolveNotificationProvider();
  if (!provider) return unavailable(res);

  const target = targetFrom(res);
  if (!target) return unauthorized(res);

  await provider.remove(target, String(req.params.id));
  return res.json({ ok: true });
};
