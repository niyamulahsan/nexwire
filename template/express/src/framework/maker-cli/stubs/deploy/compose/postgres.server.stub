name: ${COMPOSE_PROJECT_NAME:-nexwire}

services:
  app:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
      args:
        UI: ${UI}
    container_name: ${APP_NAME:-nexwire}-app
    restart: unless-stopped
    working_dir: /app
    ports:
      - "${APP_PORT:-3000}:3000"
    expose:
      - "3000"
    env_file:
      - .env
    environment:
      APP_ENV: production
      APP_PORT: 3000
      APP_URL: ${APP_URL:-http://localhost:3000}
      DATABASE_URL: ${DATABASE_URL}
{{REDIS_ENV_LINE}}      APP_HOST: ${APP_HOST:-localhost}
      VIRTUAL_HOST: ${VIRTUAL_HOST:-}
      VIRTUAL_PORT: ${VIRTUAL_PORT:-3000}
      LETSENCRYPT_HOST: ${LETSENCRYPT_HOST:-}
      LETSENCRYPT_EMAIL: ${LETSENCRYPT_EMAIL:-}
    volumes:
      - app-storage:/app/src/storage
    networks:
      - infra
      - nginx-proxy

volumes:
  app-storage:

networks:
  infra:
    external: true
    name: infra
  nginx-proxy:
    external: true
    name: nginx-proxy

