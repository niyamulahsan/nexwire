{
  "remote": {
    "host": "127.0.0.1",
    "user": "deploy",
    "port": 22,
    "keyPath": "~/.ssh/id_rsa",
    "targetPath": "/home/deploy/nexwire"
  },
  "upload": {
    "source": ".",
    "targetSubPath": "."
  },
  "databaseImport": {
    "enabled": false,
    "file": "deploy/nexwire.sql",
    "database": "nexwire",
    "container": "mysql-global",
    "user": "root"
  },
  "preDeployCommands": [
    "docker rm -f old-app 2>/dev/null || true"
  ]
}

