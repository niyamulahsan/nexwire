import { randomUUID } from "node:crypto";
import { and, count, desc, eq, isNull } from "drizzle-orm";
import { db } from "@/framework/database/connection.js";
import type {
  NotifiableTarget,
  NotificationCreateInput,
  NotificationListOptions,
  NotificationPage,
  NotificationProvider,
  NotificationRecord
} from "@/framework/providers/contracts.js";
import { registerNotificationProvider } from "@/framework/providers/registry.js";
import { notifications } from "@/modules/{{module}}/database/models/notification.js";

/** Normalize a target into the polymorphic pair stored in the table. */
function normalizeTarget(target: NotifiableTarget) {
  const type = String(target?.type || "user").trim() || "user";
  if (target?.id === undefined || target?.id === null || target?.id === "") {
    throw new Error("A notification target needs an id.");
  }
  return { type, id: String(target.id) };
}

/** Build the owner scope shared by every read and write. */
function scope(target: NotifiableTarget) {
  const normalized = normalizeTarget(target);
  return {
    target: normalized,
    where: and(eq(notifications.notifiableType, normalized.type), eq(notifications.notifiableId, normalized.id))
  };
}

function toIso(value: Date | string | number | null | undefined): string | null {
  if (value === null || value === undefined) return null;
  const date = value instanceof Date ? value : new Date(value);
  return Number.isNaN(date.getTime()) ? null : date.toISOString();
}

function parseData(value: unknown): Record<string, unknown> | null {
  if (!value) return null;
  if (typeof value === "object") return value as Record<string, unknown>;
  try {
    const parsed = JSON.parse(String(value));
    return parsed && typeof parsed === "object" ? (parsed as Record<string, unknown>) : null;
  } catch {
    return null;
  }
}

/** Convert a DB row into the stable shape every consumer receives. */
function normalizeRow(row: typeof notifications.$inferSelect): NotificationRecord {
  return {
    id: String(row.id),
    notifiableType: row.notifiableType,
    notifiableId: row.notifiableId,
    type: row.type,
    title: row.title,
    body: row.body ?? null,
    data: parseData(row.data),
    link: row.link ?? null,
    readAt: toIso(row.readAt),
    createdAt: toIso(row.createdAt) ?? new Date(0).toISOString()
  };
}

/**
 * Why: Ships a working notification store so `notify()` needs no setup.
 * When: Imported at boot by the provider loader (and lazily by the resolver).
 * Where: `src/modules/notification/providers/notification.ts`.
 * How: Drizzle-backed implementation of `NotificationProvider`. The primary
 *      key is a UUID string, so ids never depend on the auth table; numeric
 *      targets are accepted and stored as text by the contract.
 */
export const notificationProvider: NotificationProvider = {
  async create(target: NotifiableTarget, input: NotificationCreateInput): Promise<NotificationRecord> {
    const { target: normalized } = scope(target);
    const id = randomUUID();

    await db.insert(notifications).values({
      id,
      notifiableType: normalized.type,
      notifiableId: normalized.id,
      type: input.type || "info",
      title: input.title,
      body: input.body ?? null,
      link: input.link ?? null,
      data: input.data ? JSON.stringify(input.data) : null
    });

    const [row] = await db.select().from(notifications).where(eq(notifications.id, id));
    if (!row) throw new Error("Failed to create notification");
    return normalizeRow(row);
  },

  async list(target: NotifiableTarget, options: NotificationListOptions = {}): Promise<NotificationPage> {
    const { where } = scope(target);
    const page = Math.max(1, Math.floor(Number(options.page) || 1));
    const perPage = Math.min(100, Math.max(1, Math.floor(Number(options.perPage) || 20)));

    const [totalRows, unreadRows, rows] = await Promise.all([
      db.select({ count: count() }).from(notifications).where(where),
      db.select({ count: count() }).from(notifications).where(and(where, isNull(notifications.readAt))),
      db
        .select()
        .from(notifications)
        .where(where)
        .orderBy(desc(notifications.createdAt))
        .limit(perPage)
        .offset((page - 1) * perPage)
    ]);

    return {
      data: rows.map(normalizeRow),
      total: Number(totalRows[0]?.count ?? 0),
      unread: Number(unreadRows[0]?.count ?? 0),
      page,
      perPage
    };
  },

  async unreadCount(target: NotifiableTarget): Promise<number> {
    const { where } = scope(target);
    const rows = await db
      .select({ count: count() })
      .from(notifications)
      .where(and(where, isNull(notifications.readAt)));
    return Number(rows[0]?.count ?? 0);
  },

  async markRead(target: NotifiableTarget, id: number | string): Promise<boolean> {
    const { where } = scope(target);
    const notificationWhere = and(where, eq(notifications.id, String(id)));
    const [existing] = await db.select({ id: notifications.id }).from(notifications).where(notificationWhere);
    if (!existing) return false;

    await db.update(notifications).set({ readAt: new Date() }).where(notificationWhere);
    return true;
  },

  async markAllRead(target: NotifiableTarget): Promise<number> {
    const { where } = scope(target);
    const unreadWhere = and(where, isNull(notifications.readAt));
    const rows = await db.select({ count: count() }).from(notifications).where(unreadWhere);
    const unread = Number(rows[0]?.count ?? 0);
    if (unread === 0) return 0;

    await db.update(notifications).set({ readAt: new Date() }).where(unreadWhere);
    return unread;
  },

  async remove(target: NotifiableTarget, id: number | string): Promise<boolean> {
    const { where } = scope(target);
    const notificationWhere = and(where, eq(notifications.id, String(id)));
    const [existing] = await db.select({ id: notifications.id }).from(notifications).where(notificationWhere);
    if (!existing) return false;

    await db.delete(notifications).where(notificationWhere);
    return true;
  },

  async deleteForTarget(target: NotifiableTarget): Promise<number> {
    const { where } = scope(target);
    const rows = await db.select({ count: count() }).from(notifications).where(where);
    const total = Number(rows[0]?.count ?? 0);
    if (total === 0) return 0;

    await db.delete(notifications).where(where);
    return total;
  }
};

registerNotificationProvider(notificationProvider);

export default notificationProvider;
