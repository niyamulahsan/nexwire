import type { Handler } from "hono";
import { HttpStatusCodes } from "@/framework/facade.js";
import { {{controller}}Service } from "@/modules/{{module}}/services/{{controller}}.js";

/**
 * Why: Returns every {{controller}} row for list screens.
 * When: Used by GET list endpoint.
 * Where: GET /{{controller}} route.
 */
export const index: Handler = async (c: any) => {
  const data = await {{controller}}Service.list();

  return c.json({ message: "{{controller}} list fetched successfully", data });
};

/**
 * Why: Returns one {{controller}} row by validated route id.
 * When: Used by detail screens or fetch-by-id calls.
 * Where: GET /{{controller}}/{id} route.
 */
export const show: Handler = async (c: any) => {
  const { id } = c.req.valid("param");
  const data = await {{controller}}Service.findOne(id);

  if (!data) return c.json({ message: "{{controller}} not found" }, HttpStatusCodes.NOT_FOUND);

  return c.json({ message: "{{controller}} fetched successfully", data });
};

/**
 * Why: Creates a new {{controller}} row from a validated request body.
 * When: Used by create form submissions.
 * Where: POST /{{controller}} route.
 */
export const store: Handler = async (c: any) => {
  const body = c.req.valid("json");
  const data = await {{controller}}Service.create(body);

  return c.json({ message: "{{controller}} created successfully", data }, HttpStatusCodes.CREATED);
};

/**
 * Why: Updates an existing {{controller}} row using id + body validation.
 * When: Used by edit/update form submissions.
 * Where: PUT/PATCH /{{controller}}/{id} route.
 */
export const update: Handler = async (c: any) => {
  const { id } = c.req.valid("param");
  const body = c.req.valid("json");
  const data = await {{controller}}Service.update(id, body);

  if (!data) return c.json({ message: "{{controller}} not found" }, HttpStatusCodes.NOT_FOUND);

  return c.json({ message: "{{controller}} updated successfully", data });
};

/**
 * Why: Deletes one {{controller}} row by validated route id.
 * When: Used by delete actions.
 * Where: DELETE /{{controller}}/{id} route.
 */
export const destroy: Handler = async (c: any) => {
  const { id } = c.req.valid("param");
  const data = await {{controller}}Service.remove(id);

  if (!data) return c.json({ message: "{{controller}} not found" }, HttpStatusCodes.NOT_FOUND);

  return c.json({ message: "{{controller}} deleted successfully", data });
};