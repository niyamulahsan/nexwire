    "@vitejs/plugin-vue": "^6.0.8",
    "@vuepic/vue-datepicker": "^14.0.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/head": "^2.0.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bullmq": "^5.81.3",
    "bullmq-durable": "^0.2.0",
    "chalk": "^5.6.2",
