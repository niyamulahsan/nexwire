{
  "name": "nexwire-hono",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "bin": {
    "maker": "./src/framework/maker-cli/index.mjs"
  },
  "scripts": {
    "build": "npm run build:all",
    "build:all": "npm run build:backend && npm run build:ui",
    "build:backend": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:ui": "node src/framework/maker-cli/runtime/build-ui.mjs",
    "dev": "node src/framework/maker-cli/index.mjs dev",
    "backend": "node src/framework/maker-cli/index.mjs serve --src",
    "ui": "node src/framework/maker-cli/index.mjs ui:dev",
    "maildev:view": "node src/framework/maker-cli/index.mjs maildev:view",
    "redis:view": "node src/framework/maker-cli/index.mjs redis:view",
    "db:studio": "node src/framework/maker-cli/index.mjs db:studio",
    "maker": "node src/framework/maker-cli/index.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
