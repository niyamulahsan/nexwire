    "mysql2": "^3.23.3",
    "nodemailer": "^9.0.5",
    "pinia": "^3.0.4",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "redis-commander": "^0.9.0",
    "sass": "^1.100.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
