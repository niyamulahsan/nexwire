import { group } from "@/framework/facade.js";
import { downloadGenerated, downloadGeneratedExcel, downloadGeneratedPdf, fire, fireBroadcast, fireQueued, fireQueuedBroadcast, generateDownload, generateExcelDownload, generatePdfDownload, importExcel, queueCommand, upload } from "@/modules/{{module}}/controllers/{{module}}.controller.js";

export default group()
  .post("/event", fire)
  .post("/queue/command", queueCommand)
  .post("/event/queued", fireQueued)
  .post("/event/queued-broadcast", fireQueuedBroadcast)
  .post("/event/broadcast", fireBroadcast)
  .post("/upload", upload)
  .post("/import/excel", importExcel)
  .post("/download/generate", generateDownload)
  .get("/download/:token", downloadGenerated)
  .post("/download/excel/generate", generateExcelDownload)
  .get("/download/excel/:token", downloadGeneratedExcel)
  .post("/download/pdf/generate", generatePdfDownload)
  .get("/download/pdf/:requestId", downloadGeneratedPdf);

