# ── App ────────────────────────────────────────────
APP_NAME=nexwire
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Frontend origin when UI is on a different domain than the API.
# Leave empty if UI is served from the same APP_URL.
FRONTEND_URL=

# ── Database ───────────────────────────────────────
# Supported: sqlite:, mysql://, postgres://
# Default is SQLite so a fresh clone runs with zero setup (no server to install).
# The dev stack migrates + seeds automatically on first run.
# Switch later, e.g. mysql://root:@localhost:3306/nexwire
DATABASE_URL=sqlite:./src/storage/database/nexwire.sqlite

# ── Secrets ────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
COOKIE_SECRET=change-me-cookie
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Redis ──────────────────────────────────────────
# Set true to enable cache, session, queue, events, and Queue Dashboard
REDIS=true
# Shared key prefix for cache, session, queue, events, and dashboards
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=nexwire

# ── Feature Toggle ─────────────────────────────────
# Set false for API-only mode (no UI build/serve)
UI=true
# Set true to enable OpenAPI / Scalar docs at /api-docs
OPEN_API=true
# Set false to disable Socket.IO realtime server
SOCKET=true
# Set false to disable browser security headers (CSP, HSTS, X-Frame)
SECURITY_HEADERS=true


