{
  "name": "nexwire-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:hono": "node scripts/sync-template.mjs hono",
    "sync:express": "node scripts/sync-template.mjs express",
    "docs:dev": "npm -C packages/docs run dev",
    "docs:build": "npm -C packages/docs run build",
    "docs:preview": "npm -C packages/docs run preview",
    "prepublish:cli": "npm run sync:hono && npm run sync:express",
    "publish:cli": "cd packages/create-nexwire && npm publish"
  }
}